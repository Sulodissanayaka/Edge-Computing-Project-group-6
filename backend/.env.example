# Camera index, video file, or RTSP/HTTP stream URL.
CAMERA_SOURCE=0

MODEL_PATH=models/classroom_person.onnx
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
FRAME_INTERVAL=0.02
DEVICE_NAME=Classroom Edge Device

# AC protection: confirm occupancy before changing commands, prevent compressor
# short-cycling, and avoid frequent temperature setpoint changes.
OCCUPANCY_CONFIRM_SECONDS=15
OCCUPANCY_RELEASE_SECONDS=60
AC_MIN_ON_SECONDS=300
AC_MIN_OFF_SECONDS=30
TEMP_CHANGE_COOLDOWN_SECONDS=600

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
